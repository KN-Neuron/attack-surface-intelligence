# Documentation assistant (optional). Copy to .env.local and adjust.
# ollama | lmstudio
ASSISTANT_PROVIDER=ollama

# Ollama (default provider)
OLLAMA_URL=http://127.0.0.1:11434

# LM Studio (used when ASSISTANT_PROVIDER=lmstudio)
LMSTUDIO_URL=http://127.0.0.1:1234

# Model name. Defaults to gemma3:1b for Ollama; for LM Studio the first chat model.
# ASSISTANT_MODEL=gemma3:1b

# Optional Ollama GPU layer count.
# ASSISTANT_NUM_GPU=0
